{
    "name": "efabrica/phpstan-config",
    "description": "Custom configs for PHPstan",
    "keywords": ["PHPstan", "config"],
    "require": {
        "php": "^8.1",
        "phpstan/phpstan": "^1.10.6",
        "phpstan/phpstan-nette": "^1.0",
        "phpstan/phpstan-symfony": "^1.3",
        "phpstan/phpstan-deprecation-rules": "^1.0",
        "phpstan/phpstan-strict-rules": "^1.0",
        "phpstan/phpstan-webmozart-assert": "^1.0",
        "spaze/phpstan-disallowed-calls": "^2.0",
        "pepakriz/phpstan-exception-rules": "^0.12",
        "efabrica/phpstan-rules": "^0.8.1",
        "efabrica/phpstan-latte": "^0.17.1",
        "sidz/phpstan-rules": "^0.4.5"
    },
    "require-dev": {
        "tomaj/hermes": "^4.2",
        "nette/database": "^3.2",
        "phpunit/phpunit": "^9.5"
    },
    "autoload": {
        "psr-4": {
            "Efabrica\\PhpstanConfig\\": "src",
            "PHPStanConfig\\": "src"
        }
    },
    "autoload-dev": {
        "classmap": [
            "tests/Mocks"
        ],
        "psr-4": {
            "PHPStanConfig\\Tests\\Rules\\": "tests/Rules"
        }
    },
    "scripts": {
        "tests": "vendor/bin/phpunit tests/Rule"
    }
}
